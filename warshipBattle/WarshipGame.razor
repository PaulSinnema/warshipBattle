@implements IAsyncDisposable
@inject IJSRuntime JS

<canvas id="sea" class="sea"></canvas>

<div class="version">v@(AppVersion)</div>

<canvas id="minimap" class="minimap" width="150" height="150"></canvas>

<div class="zoom">
    <button data-key="ZoomIn" title="Inzoomen (+ of scrollwiel)">+</button>
    <button data-key="ZoomOut" title="Uitzoomen (− of scrollwiel)">−</button>
</div>

<div class="rotate"><span>⟳</span>Draai je telefoon naar liggend</div>

@if (state == "playing")
{
    <div class="hud">
        <div class="coins">🪙 @FormatCoins(coins)</div>
        <div>@Current.Name &nbsp;•&nbsp; @ActiveDiff.Name</div>
        <div>Verslagen: @kills</div>
        <div class="health"><div class="health-bar" style="@($"width:{health}%")"></div></div>
        <div class="repair">🔧 @StatusText(repairState, "R")</div>
        @if (Current.Special != "")
        {
            <div class="repair">⚡ @Current.SpecialName: @StatusText(specialState, "F")</div>
        }
        @if (jetsAir >= 0)
        {
            <div class="repair">✈ Straaljagers in de lucht: @jetsAir / @Current.Jets</div>
            @if (jetCooldown > 0)
            {
                <div class="repair">✈ Bijtanken en herbewapenen: @(jetCooldown)s</div>
            }
            else if (jetCooldown < 0)
            {
                <div class="repair">✈ Wachten tot alle straaljagers geland zijn</div>
            }
        }
    </div>
    <button class="pause-btn" @onclick="Pause">II</button>
}

<div class="touch">
    @* Joystick: push left / right to steer, springs back to the centre *@
    <div class="stick" id="stick">
        <div class="stick-ring"></div>
        <div class="stick-knob" id="stickKnob"></div>
    </div>
    <div class="right">
        <div class="btns">
            <button class="fix" data-key="KeyF" title="Speciaal wapen">⚡</button>
            <button class="fix" data-key="KeyR" title="Noodreparatie">🔧</button>
            <button class="fix" id="fireBtn" title="Vuur (houd ingedrukt)">💥</button>
            <button class="fix" data-key="KeyG" title="Dieptebommen">💣</button>
            <button class="fix" data-key="KeyT" title="Opstijgen / landen">✈</button>
            <button class="fix" data-key="KeyE" title="Naar je schip (na landen)">🚢</button>
        </div>
        @* Throttle lever: only shown while your aircraft is in the air (top = full power, bottom = minimum) *@
        <div class="throttle" id="throttle" style="display:none">
            <div class="thr-mark" style="top:0">VOL</div>
            <div class="thr-mark" style="bottom:0">MIN</div>
            <div class="thr-knob" id="thrKnob"><span id="thrLabel">0%</span></div>
        </div>
    </div>
</div>

@if (showShop)
{
    <div class="overlay shop">
        <h1>SCHEEPSWERF</h1>
        <div class="coins">🪙 @FormatCoins(coins)</div>
        @if (CanRepair)
        {
            <div class="repair-row">
                Schade: @(100 - health)% &nbsp;
                <button class="alt" disabled="@(coins < RepairCost)" @onclick="RepairShip">Repareren 🪙 @FormatCoins(RepairCost)</button>
            </div>
        }
        <div class="ships">
            @foreach (var s in ShipCatalog.All)
            {
                <div class="card @(s.Id == selectedId && vehicle == "ship" ? "sel" : "")">
                    <canvas id="@($"prev-{s.Id}")" class="preview" width="200" height="56"></canvas>
                    <h3>@s.Name</h3>
                    <div class="desc">@s.Description</div>
                    @if (s.Special != "")
                    {
                        <div class="special">⚡ @s.SpecialName &nbsp;•&nbsp; @s.SpecialCooldown s</div>
                    }
                    @if (s.Jets > 0)
                    {
                        <div class="special">✈ @s.Jets straaljagers, elk 5 bommen die een schip in één keer vernietigen (1 start per 15 s, na een ronde 1 min bijtanken)</div>
                    }
                    <table class="stats">
                        <tr><td>Kanonnen</td><td>@s.GunLabel</td></tr>
                        <tr><td>Pantser</td><td>@s.Hp</td></tr>
                        <tr><td>Snelheid</td><td>@s.Speed</td></tr>
                        <tr><td>Roer</td><td>@s.Turn °/s</td></tr>
                        <tr><td>Torens draaien</td><td>@s.TurretTurn °/s</td></tr>
                        <tr><td>Herladen</td><td>@s.Reload.ToString("0.0", CultureInfo.InvariantCulture) s</td></tr>
                        <tr><td>Schade</td><td>@s.Damage</td></tr>
                        <tr><td>Bereik</td><td>@s.Range</td></tr>
                    </table>
                    @if (owned.Contains(s.Id))
                    {
                        @* Upgrades: armour, reload, range, speed — 5 levels each *@
                        <div class="upg">
                            @for (var i = 0; i < UpgradeNames.Length; i++)
                            {
                                var idx = i;
                                var lvl = Level(s, idx);
                                <button class="alt" disabled="@(lvl >= MaxUpgrade || coins < UpgradeCost(s, idx))" @onclick="() => BuyUpgrade(s, idx)">
                                    @UpgradeNames[idx] @lvl/@MaxUpgrade<br />
                                    <small>@(lvl >= MaxUpgrade ? "max" : $"🪙 {FormatCoins(UpgradeCost(s, idx))}")</small>
                                </button>
                            }
                        </div>
                    }
                    @if (s.Id == selectedId && vehicle == "ship")
                    {
                        <button disabled>Geselecteerd</button>
                    }
                    else if (owned.Contains(s.Id))
                    {
                        @* No switching ships during a game *@
                        <button disabled="@InGame" @onclick="() => SelectShip(s)">@(InGame ? "Kiezen na het spel" : "Kiezen")</button>
                    }
                    else
                    {
                        <button disabled="@(coins < s.Price)" @onclick="() => BuyShip(s)">Kopen 🪙 @FormatCoins(s.Price)</button>
                    }
                </div>
            }
        </div>
        <button @onclick="CloseShop">Terug</button>
    </div>
}
else if (showMedals)
{
    <div class="overlay shop">
        <h1>PRESTATIES</h1>
        @if (rank is not null)
        {
            <div class="rank" style="@($"--rc:{rank.Color}")">
                <b>🎖 Rang: @rank.Name</b>
                <div class="rank-bar"><i style="@($"width:{(int)(rank.Progress * 100)}%")"></i></div>
                <span>@(rank.Next != "" ? $"{rank.Kills} / {rank.NextKills} schepen tot zinken gebracht → {rank.Next}" : $"{rank.Kills} schepen — hoogste rang!")</span>
            </div>
            <div class="ladder">
                @foreach (var r in rank.Ladder)
                {
                    <span class="@(r.Done ? "done" : "")" style="@($"--rc:{r.Color}")">@r.Name<small>@r.Kills</small></span>
                }
            </div>
        }
        <div class="controls">@medals.Count(m => m.Done) / @medals.Length prestaties behaald</div>
        <div class="medals">
            @foreach (var m in medals)
            {
                <div class="medal @(m.Done ? "done" : "")">
                    <b>@(m.Done ? "🏅" : "🔒") @m.Name</b>
                    <span>@m.Desc</span>
                </div>
            }
        </div>
        <h3>Ranglijst — @DifficultyCatalog.Get(diffId).Name</h3>
        @if (scores.Length == 0)
        {
            <div class="controls">Nog geen scores op deze moeilijkheid.</div>
        }
        else
        {
            <table class="stats scores">
                <tr><td>#</td><td>Kills</td><td>Tijd</td><td>Schip</td><td>Datum</td></tr>
                @for (var i = 0; i < scores.Length; i++)
                {
                    var sc = scores[i];
                    <tr><td>@(i + 1)</td><td>@sc.Kills</td><td>@(sc.Secs / 60):@((sc.Secs % 60).ToString("00"))</td><td>@sc.Ship</td><td>@sc.Date</td></tr>
                }
            </table>
        }
        <button @onclick="() => showMedals = false">Terug</button>
    </div>
}
else if (showHangar)
{
    <div class="overlay shop">
        <h1>HANGAR</h1>
        <div class="coins">🪙 @FormatCoins(coins)</div>
        <div class="controls">Vaar naar een eiland met een ✈ landingsbaan en druk op T (of ✈) om op te stijgen. Druk boven een landingsbaan op T om te landen.</div>
        <div class="ships">
            @foreach (var p in PlaneCatalog.All)
            {
                <div class="card @(p.Id == selectedPlane && vehicle == "plane" ? "sel" : "")">
                    <canvas id="@($"plane-{p.Id}")" class="preview" width="200" height="110"></canvas>
                    <h3>@p.Name</h3>
                    <div class="desc">@p.Description</div>
                    <table class="stats">
                        <tr><td>Wapens</td><td>@p.GunLabel</td></tr>
                        <tr><td>Bewapening</td><td>@p.OrdLabel</td></tr>
                        <tr><td>Pantser</td><td>@p.Hp</td></tr>
                        <tr><td>Snelheid</td><td>@p.MinSpeed–@p.Speed</td></tr>
                        <tr><td>Wendbaarheid</td><td>@p.Turn °/s</td></tr>
                        <tr><td>Brandstof</td><td>@p.Fuel s</td></tr>
                    </table>
                    @if (p.Id == selectedPlane && vehicle == "plane")
                    {
                        <button disabled>Geselecteerd</button>
                    }
                    else if (ownedPlanes.Contains(p.Id))
                    {
                        <button disabled="@InGame" @onclick="() => SelectPlane(p)">@(InGame ? "Kiezen na het spel" : "Kiezen")</button>
                    }
                    else
                    {
                        <button disabled="@(coins < p.Price)" @onclick="() => BuyPlane(p)">Kopen 🪙 @FormatCoins(p.Price)</button>
                    }
                </div>
            }
        </div>
        <button @onclick="() => showHangar = false">Terug</button>
    </div>
}
else
{
    switch (state)
    {
        case "loading":
            <div class="overlay"><h1>WARSHIP BATTLE</h1><div>Laden…</div></div>
            break;
        case "start":
            <div class="overlay start">
                <h1>WARSHIP BATTLE</h1>
                <div class="controls">Schakel vijandelijke schepen uit op een eindeloze oceaan.</div>
                @if (rank is not null)
                {
                    @* Rank by total ships sunk *@
                    <div class="rank" style="@($"--rc:{rank.Color}")">
                        <b>🎖 @rank.Name</b>
                        <div class="rank-bar"><i style="@($"width:{(int)(rank.Progress * 100)}%")"></i></div>
                        <span>@(rank.Next != "" ? $"{rank.Kills} / {rank.NextKills} schepen → {rank.Next}" : $"{rank.Kills} schepen — hoogste rang!")</span>
                    </div>
                }
                <div class="diffs">
                    @foreach (var d in DifficultyCatalog.All)
                    {
                        var locked = earned < d.Unlock;
                        <button class="diff @(d.Id == diffId ? "sel" : "")" disabled="@locked" @onclick="() => SelectDiff(d)">
                            <b>@d.Name</b>
                            @if (locked)
                            {
                                <span>🔒 vanaf 🪙 @FormatCoins(d.Unlock) verdiend</span>
                            }
                            else
                            {
                                <span>🪙 @FormatCoins(d.Reward) per schip</span>
                            }
                        </button>
                    }
                </div>
                <div class="controls">@(vehicle == "plane" && PlaneCatalog.Get(selectedPlane) is { } vp ? $"Vliegtuig: {vp.Name} (start op een landingsbaan, {Current.Name} als thuisbasis)" : $"Schip: {Current.Name}") &nbsp;•&nbsp; 🪙 @FormatCoins(coins)</div>
                <div class="buttons">
                    <button @onclick="StartGame">Start</button>
                    <button class="alt" @onclick="OpenShop">Scheepswerf</button>
                    <button class="alt" @onclick="OpenHangar">✈ Hangar</button>
                    <button class="alt" @onclick="OpenMedals">🏅 Prestaties</button>
                </div>
                <div class="buttons small">
                    <button class="alt" @onclick="() => popup = popup == 1 ? 0 : 1">❓ Besturing</button>
                    <button class="alt" @onclick="() => popup = popup == 2 ? 0 : 2">⚙ Instellingen</button>
                </div>
            </div>
            @if (popup == 1)
            {
                @* Controls help *@
                <div class="popup-bg" @onclick="() => popup = 0">
                    <div class="popup" @onclick:stopPropagation="true">
                        <h2>❓ Besturing</h2>
                        <table class="stats help">
                            <tr><th></th><th>Computer</th><th>Telefoon</th></tr>
                            <tr><td>Varen</td><td>W/S of ▲▼ vaart, A/D of ◀▶ roer, X stop</td><td>joystick (omhoog vooruit, omlaag achteruit, opzij sturen)</td></tr>
                            <tr><td>Richten en vuren</td><td>muis richten, klik/spatie vuren</td><td>tik op zee (of vlak bij een schip), 💥</td></tr>
                            <tr><td>Speciaal wapen</td><td>F of rechtsklik</td><td>⚡</td></tr>
                            <tr><td>Noodreparatie</td><td>R</td><td>🔧</td></tr>
                            <tr><td>Dieptebommen</td><td>G</td><td>💣</td></tr>
                            <tr><td>Opstijgen / landen</td><td>T</td><td>✈</td></tr>
                            <tr><td>Na de landing naar je schip</td><td>E</td><td>🚢</td></tr>
                            <tr><td>Vliegen</td><td>W/S gas, A/D sturen, F bommen/raketten</td><td>joystick (omhoog meer gas), ⚡</td></tr>
                            <tr><td>Zoomen</td><td>scrollwiel of + / −</td><td>knijpen of + / −</td></tr>
                            <tr><td>Pauze / geluid</td><td>Esc / M</td><td>⏸</td></tr>
                        </table>
                        <div class="controls">
                            Mik zelf op vliegtuigen om ze neer te halen &nbsp;•&nbsp; vaar langzaam naar een ⚓ haven voor gratis reparatie en missies<br />
                            Landen: langzaam en recht over een landingsbaan of je vliegdekschip, dan T &nbsp;•&nbsp; taxi zelf terug naar het begin om op te stijgen
                        </div>
                        <button @onclick="() => popup = 0">Sluiten</button>
                    </div>
                </div>
            }
            else if (popup == 2)
            {
                @* Settings: graphics level *@
                <div class="popup-bg" @onclick="() => popup = 0">
                    <div class="popup" @onclick:stopPropagation="true">
                        <h2>⚙ Instellingen</h2>
                        <div class="controls">Graphics</div>
                        <div class="gfx-pick">
                            @for (var i = -1; i < GfxNames.Length - 1; i++)
                            {
                                var lv = i;
                                <button class="diff @(gfx == lv ? "sel" : "")" @onclick="() => SetGfx(lv)">@GfxNames[lv + 1]</button>
                            }
                        </div>
                        @if (graphics != "")
                        {
                            <div class="controls gfx">🖥 @graphics</div>
                        }
                        <div class="controls">Hapert het spel? Kies Laag of Ultra laag.</div>
                        <button @onclick="() => popup = 0">Sluiten</button>
                    </div>
                </div>
            }
            break;
        case "paused":
            <div class="overlay">
                <h1>PAUZE</h1>
                <div class="controls">Pantser: @health% &nbsp;•&nbsp; 🪙 @FormatCoins(coins)</div>
                <div class="buttons">
                    <button @onclick="Resume">Verder</button>
                    @if (CanRepair)
                    {
                        <button class="alt" disabled="@(coins < RepairCost)" @onclick="RepairShip">Repareren 🪙 @FormatCoins(RepairCost)</button>
                    }
                    <button class="alt" @onclick="OpenShop">Scheepswerf</button>
                    <button class="alt" @onclick="OpenHangar">✈ Hangar</button>
                    <button class="alt" @onclick="Stop">Stoppen</button>
                </div>
            </div>
            break;
        case "gameover":
            <div class="overlay">
                <h1>GEZONKEN</h1>
                <div class="controls">Je schip is gezonken na @kills verslagen vijanden (@ActiveDiff.Name).<br />🪙 @FormatCoins(coins)</div>
                <div class="buttons">
                    <button @onclick="StartGame">Opnieuw</button>
                    <button class="alt" @onclick="Stop">Menu</button>
                    <button class="alt" @onclick="OpenShop">Scheepswerf</button>
                    <button class="alt" @onclick="OpenMedals">🏅 Ranglijst</button>
                </div>
            </div>
            break;
    }
}

@code {
    private static readonly string AppVersion = GetVersion();
    private static readonly string BuildId = typeof(WarshipGame).Assembly
        .GetCustomAttributes<AssemblyMetadataAttribute>().FirstOrDefault(a => a.Key == "BuildId")?.Value ?? "0";
    private DotNetObjectReference<WarshipGame>? selfRef;
    private IJSObjectReference? module;
    private string state = "loading";
    private bool showShop;
    private int kills;
    private int enemies;
    private int health = 100;
    private int coins;
    private int earned;
    private readonly HashSet<string> owned = new() { "fregat" };
    private string selectedId = "fregat";
    private string diffId = "normaal";
    private Difficulty ActiveDiff { get; set; } = DifficultyCatalog.Get("normaal");

    private const int RepairCostPerPercent = 20;
    private int repairState;
    private int specialState;
    private int jetsAir = -1;
    private int jetCooldown;
    private string graphics = "";

    // Graphics level: -1 = automatic, 0..4 = ultra low .. ultra (stored by game.js in localStorage)
    private static readonly string[] GfxNames = { "Auto", "Ultra laag", "Laag", "Middel", "Hoog", "Ultra" };
    private int gfx = -1;
    private int popup;   // start screen pop-up: 0 none, 1 controls help, 2 settings

    private async Task SetGfx(int level)
    {
        gfx = level;
        if (module is not null) await module.InvokeVoidAsync("setGraphics", level);
    }
    private bool previewsDrawn;

    private ShipType Current => ShipCatalog.Get(selectedId);

    // ---------- planes (hangar) ----------
    private bool showHangar;
    private bool planePreviewsDrawn;

    private void OpenHangar()
    {
        showHangar = true;
        planePreviewsDrawn = false;
    }
    // Only one vehicle is selected at a time: "ship" or "plane"
    private string vehicle = "ship";
    private readonly HashSet<string> ownedPlanes = new();
    private string? selectedPlane;

    private async Task BuyPlane(PlaneType p)
    {
        if (coins < p.Price || ownedPlanes.Contains(p.Id)) return;
        coins -= p.Price;
        ownedPlanes.Add(p.Id);
        if (InGame) await SaveProgress();
        else await SelectPlane(p);
    }

    private async Task SelectPlane(PlaneType p)
    {
        if (InGame) return;
        selectedPlane = p.Id;
        vehicle = "plane";
        await SaveProgress();
        if (module is not null) await module.InvokeVoidAsync("setPlane", p);
    }

    // ---------- upgrades ----------
    private static readonly string[] UpgradeNames = { "Pantser", "Herladen", "Bereik", "Snelheid" };
    private const int MaxUpgrade = 5;
    private readonly Dictionary<string, int[]> upgrades = new();

    private int Level(ShipType s, int i) => upgrades.TryGetValue(s.Id, out var u) ? u[i] : 0;

    // Cost grows with the ship price and the level
    private int UpgradeCost(ShipType s, int i) => Math.Max(500, s.Price / 5) * (Level(s, i) + 1);

    // Ship stats with the bought upgrades applied
    private ShipType Upgraded(ShipType s)
    {
        if (!upgrades.TryGetValue(s.Id, out var u)) return s;
        return s with
        {
            Hp = (int)Math.Round(s.Hp * (1 + 0.12 * u[0])),
            Reload = s.Reload * (1 - 0.07 * u[1]),
            Range = s.Range * (1 + 0.08 * u[2]),
            Speed = s.Speed * (1 + 0.05 * u[3])
        };
    }

    private async Task BuyUpgrade(ShipType s, int i)
    {
        var cost = UpgradeCost(s, i);
        if (coins < cost || Level(s, i) >= MaxUpgrade) return;
        coins -= cost;
        if (!upgrades.TryGetValue(s.Id, out var u)) upgrades[s.Id] = u = new int[UpgradeNames.Length];
        u[i]++;
        await SaveProgress();
        // Apply at once to the ship in a running (paused) game
        if (s.Id == selectedId && module is not null) await module.InvokeVoidAsync("setShip", Upgraded(s));
    }

    // ---------- medals and high scores ----------
    public sealed record MedalInfo(string Name, string Desc, bool Done);
    public sealed record ScoreInfo(int Kills, int Secs, string Date, string Ship);
    public sealed record LadderItem(string Name, string Color, int Kills, bool Done);
    public sealed record RankInfo(string Name, string Color, int Kills, string Next, int NextKills, double Progress, LadderItem[] Ladder);
    private RankInfo? rank;

    private async Task RefreshRank()
    {
        if (module is null) return;
        rank = await module.InvokeAsync<RankInfo>("getRank");
        StateHasChanged();
    }

    // Collection achievements (ships / planes owned, maxed upgrade)
    private async Task CheckCollection()
    {
        if (module is null) return;
        await module.InvokeVoidAsync("checkCollection", owned.Count, ShipCatalog.All.Count, ownedPlanes.Count, PlaneCatalog.All.Count,
            upgrades.Values.Any(u => u.Any(x => x >= MaxUpgrade)));
    }
    private bool showMedals;
    private MedalInfo[] medals = Array.Empty<MedalInfo>();
    private ScoreInfo[] scores = Array.Empty<ScoreInfo>();

    private async Task OpenMedals()
    {
        if (module is null) return;
        medals = await module.InvokeAsync<MedalInfo[]>("getMedals");
        scores = await module.InvokeAsync<ScoreInfo[]>("getScores", diffId);
        rank = await module.InvokeAsync<RankInfo>("getRank");
        showMedals = true;
    }

    private bool CanRepair => state is "playing" or "paused" && health is > 0 and < 100;

    private int RepairCost => (100 - health) * RepairCostPerPercent;

    // -1 = active, 0 = ready, >0 = cooldown seconds
    private static string StatusText(int value, string key) => value switch
    {
        < 0 => "actief…",
        0 => $"gereed ({key})",
        _ => $"{value}s"
    };

    private static string GetVersion()
    {
        var info = typeof(WarshipGame).Assembly
            .GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion ?? "0.0.0";
        var plus = info.IndexOf('+');
        return plus >= 0 ? info[..plus] : info;
    }

    private static string FormatCoins(int value) =>
        value.ToString("N0", CultureInfo.InvariantCulture).Replace(',', '.');

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            await DrawPreviews();
            return;
        }

        // Background update check (GitHub Pages)
        await JS.InvokeVoidAsync("wbUpdater.start", AppVersion);
        await LoadProgress();

        selfRef = DotNetObjectReference.Create(this);
        // Version query busts the browser/CDN cache for the game script
        module = await JS.InvokeAsync<IJSObjectReference>("import", $"./js/game.js?v={AppVersion}-{BuildId}");
        await module.InvokeVoidAsync("init", "sea", "minimap", selfRef);
            gfx = await module.InvokeAsync<int>("getGraphics");
            await CheckCollection();
            await RefreshRank();

        state = "start";
        StateHasChanged();
    }

    private async Task<int> LoadInt(string key)
    {
        var v = await JS.InvokeAsync<string?>("localStorage.getItem", key);
        return int.TryParse(v, NumberStyles.Integer, CultureInfo.InvariantCulture, out var parsed) ? parsed : 0;
    }

    private async Task LoadProgress()
    {
        try
        {
            coins = await LoadInt("wb-coins");
            earned = await LoadInt("wb-earned");

            var o = await JS.InvokeAsync<string?>("localStorage.getItem", "wb-owned");
            if (!string.IsNullOrEmpty(o))
                foreach (var id in o.Split(',', StringSplitOptions.RemoveEmptyEntries)) owned.Add(id);

            var s = await JS.InvokeAsync<string?>("localStorage.getItem", "wb-selected");
            if (s is not null && owned.Contains(s)) selectedId = s;

            var d = DifficultyCatalog.Get(await JS.InvokeAsync<string?>("localStorage.getItem", "wb-diff"));
            if (earned >= d.Unlock) diffId = d.Id;

            // Upgrades: "id:a,b,c,d;id2:..."
            var pl = await JS.InvokeAsync<string?>("localStorage.getItem", "wb-planes");
            if (!string.IsNullOrEmpty(pl))
                foreach (var id in pl.Split(',', StringSplitOptions.RemoveEmptyEntries)) ownedPlanes.Add(id);
            var ps = await JS.InvokeAsync<string?>("localStorage.getItem", "wb-plane");
            if (ps is not null && ownedPlanes.Contains(ps)) selectedPlane = ps;
            var vh = await JS.InvokeAsync<string?>("localStorage.getItem", "wb-vehicle");
            vehicle = vh == "plane" && selectedPlane is not null ? "plane" : "ship";
            var up = await JS.InvokeAsync<string?>("localStorage.getItem", "wb-upg");
            if (!string.IsNullOrEmpty(up))
                foreach (var part in up.Split(';', StringSplitOptions.RemoveEmptyEntries))
                {
                    var kv = part.Split(':');
                    if (kv.Length != 2) continue;
                    var lv = kv[1].Split(',').Select(x => int.TryParse(x, out var n) ? Math.Clamp(n, 0, MaxUpgrade) : 0).ToArray();
                    if (lv.Length == UpgradeNames.Length) upgrades[kv[0]] = lv;
                }
        }
        catch (JSException) { }
    }

    private async Task SaveProgress()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "wb-coins", coins.ToString(CultureInfo.InvariantCulture));
            await JS.InvokeVoidAsync("localStorage.setItem", "wb-earned", earned.ToString(CultureInfo.InvariantCulture));
            await JS.InvokeVoidAsync("localStorage.setItem", "wb-owned", string.Join(',', owned));
            await JS.InvokeVoidAsync("localStorage.setItem", "wb-selected", selectedId);
            await JS.InvokeVoidAsync("localStorage.setItem", "wb-diff", diffId);
            await JS.InvokeVoidAsync("localStorage.setItem", "wb-upg",
                string.Join(';', upgrades.Select(kv => $"{kv.Key}:{string.Join(',', kv.Value)}")));
            await JS.InvokeVoidAsync("localStorage.setItem", "wb-planes", string.Join(',', ownedPlanes));
            await JS.InvokeVoidAsync("localStorage.setItem", "wb-plane", selectedPlane ?? "");
            await JS.InvokeVoidAsync("localStorage.setItem", "wb-vehicle", vehicle);
            await CheckCollection();
        }
        catch (JSException) { }
    }

    private async Task SelectDiff(Difficulty d)
    {
        if (earned < d.Unlock) return;
        diffId = d.Id;
        await SaveProgress();
    }

    private async Task StartGame()
    {
        showShop = false;
        ActiveDiff = DifficultyCatalog.Get(diffId);
        if (module is not null)
        {
            await module.InvokeVoidAsync("startGame", Upgraded(Current), ActiveDiff);
            await module.InvokeVoidAsync("setPlane", PlaneCatalog.Get(selectedPlane));
            // Plane selected: start in the air, the ship waits as home base
            if (vehicle == "plane" && selectedPlane is not null) await module.InvokeVoidAsync("startFlying");
        }
    }

    private async Task Pause()
    {
        if (module is not null) await module.InvokeVoidAsync("setPaused", true);
    }

    private async Task Resume()
    {
        if (module is not null) await module.InvokeVoidAsync("setPaused", false);
    }

    private async Task Stop()
    {
        if (module is not null) await module.InvokeVoidAsync("stopGame");
    }

    private void OpenShop()
    {
        showShop = true;
        previewsDrawn = false;
    }

    private void CloseShop() => showShop = false;

    private async Task DrawPreviews()
    {
        if (module is null) return;
        // Hangar: aircraft pictures
        if (showHangar && !planePreviewsDrawn)
        {
            planePreviewsDrawn = true;
            foreach (var p in PlaneCatalog.All)
                await module.InvokeVoidAsync("drawPlanePreview", $"plane-{p.Id}", p);
        }
        if (!showShop || previewsDrawn) return;
        previewsDrawn = true;
        foreach (var s in ShipCatalog.All)
            await module.InvokeVoidAsync("drawPreview", $"prev-{s.Id}", s);
    }

    private async Task RepairShip()
    {
        if (!CanRepair || coins < RepairCost || module is null) return;
        coins -= RepairCost;
        await SaveProgress();
        await module.InvokeVoidAsync("repairFull");
    }

    // A game is running (or paused): switching ship or plane is not allowed then
    private bool InGame => state is "playing" or "paused";

    private async Task BuyShip(ShipType ship)
    {
        if (coins < ship.Price || owned.Contains(ship.Id)) return;
        coins -= ship.Price;
        owned.Add(ship.Id);
        // Bought during a game: keep it for later, do not switch now
        if (InGame) await SaveProgress();
        else await SelectShip(ship);
    }

    private async Task SelectShip(ShipType ship)
    {
        if (InGame) return;
        selectedId = ship.Id;
        vehicle = "ship";
        await SaveProgress();
        if (module is not null) await module.InvokeVoidAsync("setShip", Upgraded(ship));
    }

    [JSInvokable]
    public void OnStatus(string newState, int newKills, int enemiesLeft, int newHealth, int newRepair, int newSpecial, int newJets, int newJetCooldown)
    {
        jetsAir = newJets;
        jetCooldown = newJetCooldown;
        // Back in the menu: update the rank shown there
        if (newState != state && newState is "start" or "gameover") _ = RefreshRank();
        state = newState;
        kills = newKills;
        enemies = enemiesLeft;
        health = newHealth;
        repairState = newRepair;
        specialState = newSpecial;
        if (newState == "playing") showShop = false;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnGraphics(string info)
    {
        graphics = info;
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnKill()
    {
        coins += ActiveDiff.Reward;
        earned += ActiveDiff.Reward;
        await SaveProgress();
        StateHasChanged();
    }

    // Bonus coins: missions, flagship, aircraft
    [JSInvokable]
    public async Task OnReward(int amount)
    {
        coins += amount;
        earned += amount;
        await SaveProgress();
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (module is not null)
        {
            try { await module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        selfRef?.Dispose();
    }
}
